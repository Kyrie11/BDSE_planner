+export BDSE_ROOT="${BDSE_ROOT:-$SCRIPT_DIR}"
+cd "$BDSE_ROOT"
+export PYTHONPATH="$BDSE_ROOT${PYTHONPATH:+:$PYTHONPATH}"
+export OUTPUTS_ROOT="${OUTPUTS_ROOT:-$BDSE_ROOT/outputs}"
