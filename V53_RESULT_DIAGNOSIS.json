  ],
  "algorithm_findings": [
    {
      "issue": "non_integrable_pair_tournament_anchor",
      "severity": "primary algorithm bottleneck",
      "evidence": {
        "dense_full_action_match": 0.359,
        "sparse_selected_local_action_match": 0.141,
        "local_pair_full_action_match": 0.118,
        "residual_pair_full_action_match": 0.1,
        "budget_vs_pair_full_match": 0.987
      },
      "description": "The sparse pair tournament was reconstructed from J0 plus queried pair edges. Missing edges fell back to J0 and discarded the stronger selected-local evidence. The exact selector then faithfully preserved a weak/wrong pair-full winner.",
      "fixed_in_v54": true
    },
    {
      "issue": "residual_net_harmful_and_nearly_inactive_at_deployment",
      "evidence": {
        "beneficial_rate": 0.015,
        "harmful_rate": 0.033,
        "candidate_vs_local_deployed_flip_rate": 0.0040000000000000036,
        "candidate_vs_local_pair_full_flip_rate": 0.0050000000000000044
      },
      "description": "Residual changes very few deployed actions and is net harmful when it changes the interface. The residual target is not anchored to an integrable selected-local action score.",
      "fixed_in_v54": true
    },
    {
      "issue": "selector_target_is_wrong_not_selector_coverage",
      "evidence": {
        "proposal_decisive_recall": 0.8005056942782699,
        "selected_decisive_recall": 0.58808217130285,
        "effective_decisive_recall": 0.753746355669426,
        "interaction_decisive_recall": 0.5546219975722758,
        "certificate_fraction": 0.8210166666666666,
        "fallback_rate": 0.157,
        "budget_vs_pair_full_match": 0.987
      },
      "description": "Coverage/certification metrics are already competitive, but they certify preservation of the wrong pair-full target. The optimization target rather than the coreset search is the dominant issue.",
      "fixed_in_v54": true
    }
  ],
  "three_core_issue_assessment": {
    "pair_sign_to_action": {
      "status": "not solved",
      "reason": "Dense/local pair signs remain strong, but the residual pair graph is weak and non-integrable; final action match is only 0.100."
    },
    "decisive_evidence_selection": {
      "status": "coverage solved, action target not solved",
      "reason": "Selected/effective/interaction recall and AOCC certification meet competitive thresholds, yet budgeted action preserves an incorrect pair-full winner in 98.7% of scenes."
    },
    "training_compute": {
      "status": "substantially improved",
      "reason": "V53 runs at roughly 20–30 minutes per epoch versus about 42–79 minutes in V51; data loading is negligible. V54 further sparsifies pair/full-exact cadence."
    }
  },
