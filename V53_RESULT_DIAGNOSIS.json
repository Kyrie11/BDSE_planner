      "teacher-correct anchor preservation",
      "anchor-wrong teacher correction",
      "48 boundary pairs",
      "exact every 8 steps",
      "32-step full-exact tail"
    ],
    "evaluation_changes": [
      "protocol gate",
      "minimum gate",
      "competitive gate",
      "diagnostic paired CL20 on minimum failure when protocol is valid"
    ]
