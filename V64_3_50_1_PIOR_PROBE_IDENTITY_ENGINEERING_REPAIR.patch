+        missing = sorted(set(tokens) - set(by_token))[:20]
+        extra = sorted(set(by_token) - set(tokens))[:20]
+        raise RuntimeError(
+            f"V64.3.50.1 PIOR probe-event token mismatch {len(by_token)}/{len(tokens)} missing={missing} extra={extra}"
+        )
