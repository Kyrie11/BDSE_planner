+    elif not recovery:
+        next_action = "path_safe_but_too_conservative_do_not_tune_coverage_or_threshold_audit_positive_proposal_rejection"
+    elif not tail_mode_confirmation_incremental:
+        next_action = "tail_mode_confirmation_not_incremental_over_V25_DRC_do_not_tune_threshold_coverage_or_weights"
+    elif not preservation:
+        next_action = "replacement_path_safe_but_raw_harm_non_degradation_failed_audit_action_changes"
+    else:
+        next_action = "mechanism_pass_but_endpoint_fail_audit_remaining_teacher_regret_tail"
+
+    report = {
