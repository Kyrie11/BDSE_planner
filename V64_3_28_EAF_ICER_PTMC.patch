+    )
+
+    full = bool(
+        instrumentation and tail_instrumentation and structural_ok and candidate and reliability and asymmetric
+        and subset_contract["pass"] and path_safe and recovery and tail_mode_confirmation_incremental and preservation and endpoint
+    )
+    if full:
