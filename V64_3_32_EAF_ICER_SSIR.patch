+            y = _f(r, "teacher_margin") - inc_tm
+            mu = _f(r, "icer_scir_predicted_improvement")
+            scale = _f(r, "icer_scir_selection_scale", 1.0)
+            if not (math.isfinite(y) and math.isfinite(mu) and math.isfinite(scale) and scale > 0.0):
