+def _fit_weighted_zero_ridge(scene, tokens, target_fn, feature_fn, names):
+    X, y, w = [], [], []
+    for tok in tokens:
+        ss = scene[tok]
+        n = len(ss)
+        if n <= 0:
+            continue
+        for a in ss:
+            X.append(np.asarray(feature_fn(a), dtype=np.float64).reshape(-1))
+            y.append(float(target_fn(a)))
+            w.append(1.0 / n)
