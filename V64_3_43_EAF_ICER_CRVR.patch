+        "engineering_valid_both": eng,
+        "train_nested_crvr_gate_pass": train,
+        "promoted_train_arm": promoted,
+        "double_fresh_promotion_pass": bool(train and both),
+        "scientific_conclusion": (
+            "CRVR_reproduces_on_double_fresh"
