+                "selected_evidence_teacher": selected_norm,
+                "unselected_evidence_teacher": unselected_norm,
+                "base_total": base_norm,
+                "evidence_total": evid_norm,
+                "closure": closure,
+            }
+            rr.append(b)
+        out[tok] = rr
+    return out
