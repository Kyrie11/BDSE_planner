+def _dense_value(x: np.ndarray, model) -> float:
+    w, b, mean, std = model
+    z = (np.asarray(x, dtype=np.float64) - mean) / np.maximum(std, 1.0e-6)
+    return float(np.clip(z @ w + b, -40.0, 40.0))
