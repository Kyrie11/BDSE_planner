+
+def _write_dense(rsm_cfg: dict[str, Any], path: str, dense_model) -> None:
+    w, b, mean, std, _ = dense_model
+    cfg = yaml.safe_load(yaml.safe_dump(rsm_cfg, sort_keys=False))
