diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' v41_code/bdse_v64_3_41_eaf_icer_epvr/bdse/planner/value_observables.py bdse_v64_3_42_eaf_icer_ovdr/bdse/planner/value_observables.py
