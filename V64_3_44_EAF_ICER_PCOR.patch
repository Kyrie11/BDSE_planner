+
+RUNTIME_RESPONSE_MODE_NAMES = ["cv", "ca", "brake", "yield", "nonyield"]
+PLAN_RESPONSE_RAW_MODE_COST_NAMES = [f"future_response_mode_cost_{m}" for m in RUNTIME_RESPONSE_MODE_NAMES]
