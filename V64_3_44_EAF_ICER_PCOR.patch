+def _candidate_specific_cvar(values: np.ndarray, probs: np.ndarray, alpha: float) -> float:
+    v = np.asarray(values, dtype=np.float64).reshape(-1)
+    p = np.maximum(np.asarray(probs, dtype=np.float64).reshape(-1), 0.0)
