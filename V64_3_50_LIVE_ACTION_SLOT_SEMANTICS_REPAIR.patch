+def _matrix() -> np.ndarray:
+    m = np.zeros((4, 4), dtype=np.float32)
+    for b, v in [(1, 0.20), (2, 0.40), (3, 0.30)]:
+        m[b, 0] = v; m[0, b] = -v
+    return m
