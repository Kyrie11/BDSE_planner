+                "dense_runtime_raw_query_feature_allclose_fraction": float("nan"),
+                "dense_runtime_raw_query_feature_contract_pass": 0.0,
+                "dense_runtime_raw_query_feature_contract_available": 0.0,
+                "dense_runtime_query_contract_pass": 0.0,
+            }
+        )
