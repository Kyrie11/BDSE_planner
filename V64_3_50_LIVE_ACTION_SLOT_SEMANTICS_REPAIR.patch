+    provenance["v64_3_dual_calibration_json"] = str(calibration_path.resolve())
+    provenance["v64_3_shared_evidence_epsilon"] = evidence_eps
+    provenance["v64_3_evidence_beta"] = calibration_beta
+    provenance["v64_3_evidence_prior_radius"] = calibration_prior_radius
+    provenance["v64_3_residual_flip_epsilon"] = 0.0 if args.control else residual_eps
+    provenance["v64_3_residual_control"] = bool(args.control)
