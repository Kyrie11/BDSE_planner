+    n_groups=int(target.shape[0])
+    w=torch.zeros(Z.shape[1],dtype=torch.float32,requires_grad=True)
+    b=torch.zeros((),dtype=torch.float32,requires_grad=True)
+    opt=torch.optim.Adam([w,b],lr=lr)
