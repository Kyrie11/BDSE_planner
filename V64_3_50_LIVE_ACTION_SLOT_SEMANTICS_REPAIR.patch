+    delta: list[float] = []
+    tok: list[str] = []
+    sup: list[float] = []
+    scalar: list[float] = []
+    action: list[int] = []
+    eligible_before_feature = 0
+    missing_feature = 0
+    replacement_scenes: set[str] = set()
+
+    for token, rows in by.items():
+        if not rows:
+            continue
+        anchor = int(rows[0].get("anchor_action", -1))
+        incumbent = int(rows[0].get("raw_top_action", -1))
+        if incumbent < 0 or incumbent == anchor:
+            continue
