+    selected_four = torch.nonzero(mask_four[0], as_tuple=False).flatten().tolist()
+    selected_five = torch.nonzero(mask_five[0], as_tuple=False).flatten().tolist()
+    assert 0 not in selected_four and 0 not in selected_five
