+    y = np.asarray(y, dtype=np.float64)
+    w = np.asarray(w, dtype=np.float64)
+    pm = w / max(float(w.sum()), EPS)
+    scale = np.sqrt(np.sum((X * X) * pm[:, None], axis=0))
+    scale = np.maximum(scale, 1.0e-6)
+    Z = X / scale[None, :]
+    root = np.sqrt(w)[:, None]
+    Zw = Z * root
+    yw = y * root[:, 0]
