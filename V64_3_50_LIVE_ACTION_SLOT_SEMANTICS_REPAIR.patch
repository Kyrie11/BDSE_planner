+    values = np.sort(np.asarray(values, dtype=np.float64)[np.isfinite(values)])
+    if values.size == 0:
+        return float("nan")
+    rank = int(math.ceil((values.size + 1) * (1.0 - float(alpha))))
+    return float(values[min(max(rank, 1), values.size) - 1])
