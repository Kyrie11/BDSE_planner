+
+
+def test_raer_fitter_learns_separable_all_frontier_edges(tmp_path: Path) -> None:
+    rows=[]
+    for s in range(180):
+        for b in (1,2,3):
+            pos=((s+b)%2)==0
+            feat={n:0.0 for n in FEATURE_NAMES}
+            feat['raw_margin']=0.4 if b==3 else 0.2
