+        ok = value >= threshold if op == ">=" else value <= threshold
+        if not ok:
+            failures.append(f"{key}={value} {op} {threshold}")
+
+    required = {
+        "decision_budget_excludes_structural_safety": 0.5,
+        "structural_residual_enabled": 0.5,
