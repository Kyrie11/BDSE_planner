+def _scatter_subset(values: np.ndarray, indices: list[int], shape: tuple[int, int], dtype: Any) -> np.ndarray:
+    out = np.zeros(shape, dtype=dtype)
+    if indices:
+        out[np.asarray(indices, dtype=np.int64)] = values.astype(dtype, copy=False)
+    return out
