+from __future__ import annotations
+
+"""Train two fixed-budget external adapters from one shared DataLoader.
+
+The original 2-GPU launcher starts two independent Python/DataLoader stacks. For
+large NPZ caches this makes both jobs read, unzip, JSON-decode and tensorize the
+same shuffled samples at the same time.  This module keeps one CPU input stream
+and broadcasts each compact batch to two GPUs.  CUDA work is launched on the
+independent per-device default streams, so the two models still execute in
+parallel while host I/O/decoding is paid once.
+
+This trainer intentionally supports the matched pairs used by
+RUN_FAIR_EXTERNAL_BASELINES_TRAIN_B8_B16_B24_2GPU.sh: GameFormer+DTPP and
+PlanTF+PLUTO. It preserves per-model optimizers, schedulers, losses, checkpoints,
+and validation metrics.
+"""
+
+import argparse
+import importlib
+import json
+import math
+import os
+import time
+from functools import partial
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+from bdse.config import load_config
+from bdse.data.nuplan_dataset import PreprocessedBDSEDataset
+from bdse.external_baselines.losses import compute_external_baseline_losses
+from bdse.external_baselines.models import ExternalBaselineModel, external_reference, external_variant
+from bdse.external_baselines.compact_cache import (
+    CompactBatchLoader,
+    CompactExternalCache,
+    CompactIndexLoader,
+    DeviceCompactExternalCache,
+)
+from bdse.external_baselines.train import (
+    ExternalBaselineDataset,
+    _accumulate,
+    _amp_context,
+    _best_checkpoint_path,
+    _config_sha256,
+    _dataset_manifest,
+    _finalize_meters,
+    _make_optimizer,
+    _make_scaler,
+    _make_scheduler,
+    _load_resume,
+    _planner_supervision,
+    _save_checkpoint,
+    _seed_everything,
+    _seed_worker,
+    collate,
+)
+from bdse.utils import configure_torch_for_device, torch_load_any
+
+
+def _data_contract(cfg: dict[str, Any]) -> dict[str, Any]:
+    """Fields that can change compact CPU tensorization/supervision."""
+    ecfg = cfg.get("external_baseline", {}) or {}
+    mcfg = cfg.get("model", {}) or {}
+    return {
+        "candidate": cfg.get("candidate", {}) or {},
+        "evidence": cfg.get("evidence", {}) or {},
+        "pairs": cfg.get("pairs", {}) or {},
+        "runtime": cfg.get("runtime", {}) or {},
+        "planner_supervision": _planner_supervision(cfg),
+        "evidence_feature_dim": int(mcfg.get("evidence_feature_dim", 24)),
+        "proposal_feature_dim": int(mcfg.get("proposal_feature_dim", 24)),
+        "proposal_loss_enabled": float((ecfg.get("loss_weights", {}) or {}).get("proposal", 0.25)) != 0.0,
+        "pair_loss_enabled": float((ecfg.get("loss_weights", {}) or {}).get("pair", 0.0)) != 0.0,
+    }
+
+
+def _assert_pair_compatible(cfg_a: dict[str, Any], cfg_b: dict[str, Any]) -> None:
+    a, b = _data_contract(cfg_a), _data_contract(cfg_b)
+    if a != b:
+        # Give a useful compact diff instead of silently training model B with A's tensorizer.
+        keys = sorted(set(a) | set(b))
+        diff = {k: {"a": a.get(k), "b": b.get(k)} for k in keys if a.get(k) != b.get(k)}
+        raise ValueError(f"paired trainer requires identical compact data contracts; differences={diff}")
+
+
+def _setup_cuda(device: torch.device) -> None:
+    configure_torch_for_device(device)
+    if hasattr(torch, "set_float32_matmul_precision"):
+        torch.set_float32_matmul_precision("high")
+    torch.backends.cuda.matmul.allow_tf32 = True
+    torch.backends.cudnn.allow_tf32 = True
+    for name in ("enable_flash_sdp", "enable_mem_efficient_sdp", "enable_math_sdp"):
+        fn = getattr(torch.backends.cuda, name, None)
+        if callable(fn):
+            fn(True)
+
+
+def _maybe_compile(model: torch.nn.Module, *, enabled: bool, mode: str, fallback: bool) -> torch.nn.Module:
+    if not enabled:
+        return model
+    if not hasattr(torch, "compile"):
+        raise RuntimeError("torch.compile is unavailable in this PyTorch build")
+    if fallback:
+        try:
+            dynamo = importlib.import_module("torch._dynamo")
+            dynamo.config.suppress_errors = True
+        except Exception:
+            pass
+    return torch.compile(model, mode=mode)  # type: ignore[return-value]
+
+
+def _to_device(batch: dict[str, torch.Tensor], device: torch.device) -> dict[str, torch.Tensor]:
+    return {k: v.to(device, non_blocking=True) for k, v in batch.items()}
+
+
+def _cuda_mem(device: torch.device) -> tuple[float, float, float]:
+    with torch.cuda.device(device):
+        alloc = torch.cuda.memory_allocated() / (1024**3)
+        reserved = torch.cuda.memory_reserved() / (1024**3)
+        peak = torch.cuda.max_memory_allocated() / (1024**3)
+    return float(alloc), float(reserved), float(peak)
+
+
+def _resume_path(explicit: str | None, output: str, auto_resume: bool) -> Path | None:
+    if explicit:
+        return Path(explicit)
+    if not auto_resume:
+        return None
+    latest = Path(output)
+    if latest.is_file():
+        return latest
+    best = _best_checkpoint_path(output)
+    return best if best.is_file() else None
+
+
+def _peek_resume(path: Path | None) -> tuple[int, float]:
+    if path is None or not path.is_file():
+        return 0, float("inf")
+    ckpt = torch_load_any(path, map_location="cpu")
+    if not isinstance(ckpt, dict):
+        return 0, float("inf")
+    return int(ckpt.get("epoch", -1)) + 1, float(ckpt.get("best_metric", float("inf")))
+
+
+def _assert_resume_compatible(path: Path | None, cfg: dict[str, Any], cfg_path: str, *, strict: bool) -> None:
+    if path is None or not strict:
+        return
+    ckpt = torch_load_any(path, map_location="cpu")
+    if not isinstance(ckpt, dict):
+        return
+    manifest = ckpt.get("training_manifest")
+    if isinstance(manifest, dict):
+        stored_hash = str(manifest.get("config_sha256", ""))
+        current_hash = _config_sha256(cfg_path)
+        if stored_hash and stored_hash != current_hash:
+            raise ValueError(
+                f"refusing auto-resume from config-mismatched checkpoint {path}: "
+                f"stored={stored_hash} current={current_hash}. Disable --resume-strict only for an intentional migration."
+            )
+    old_cfg = ckpt.get("cfg")
+    if isinstance(old_cfg, dict):
+        old_variant = external_variant(old_cfg)
+        new_variant = external_variant(cfg)
+        old_budget = int((old_cfg.get("evidence", {}) or {}).get("budget", -1))
+        new_budget = int((cfg.get("evidence", {}) or {}).get("budget", -1))
+        old_refine = str((old_cfg.get("external_baseline", {}) or {}).get("refinement_mode", "legacy_repeated_encoder"))
+        new_refine = str((cfg.get("external_baseline", {}) or {}).get("refinement_mode", "legacy_repeated_encoder"))
+        if (old_variant, old_budget, old_refine) != (new_variant, new_budget, new_refine):
+            raise ValueError(
+                f"refusing incompatible resume {path}: old={(old_variant, old_budget, old_refine)} "
+                f"new={(new_variant, new_budget, new_refine)}"
+            )
+
+
+def _load_device_cache_pair(
+    cache: CompactExternalCache,
+    dev_a: torch.device,
+    dev_b: torch.device,
+    *,
+    mode: str,
+    layout: str,
+    float_dtype: str,
+    reserve_gib: float,
+) -> tuple[DeviceCompactExternalCache | None, DeviceCompactExternalCache | None]:
+    """Load replicated caches when possible, otherwise one shared peer source.
+
+    The old pair trainer discarded a perfectly usable one-sided cache whenever
+    the other A30 did not have enough free memory.  In ``auto`` layout we retain
+    the one-sided copy and peer-copy only the current ~MiB batch to the other GPU.
+    """
+    mode_l = str(mode).lower()
+    layout_l = str(layout).lower()
+    if mode_l == "off":
+        return None, None
+    if layout_l not in {"auto", "replicate", "peer"}:
+        raise ValueError("compact device cache layout must be auto|replicate|peer")
+    info_a = DeviceCompactExternalCache.fit_info(cache, dev_a, float_dtype=float_dtype, reserve_gib=reserve_gib)
+    info_b = DeviceCompactExternalCache.fit_info(cache, dev_b, float_dtype=float_dtype, reserve_gib=reserve_gib)
+    print(
+        f"[compact-device-pair-check] layout={layout_l} mode={mode_l} "
+        f"A_free={int(info_a['free'])/(1024**3):.2f}GiB A_fits={bool(info_a['fits'])} "
+        f"B_free={int(info_b['free'])/(1024**3):.2f}GiB B_fits={bool(info_b['fits'])}",
+        flush=True,
+    )
+    fit_a, fit_b = bool(info_a["fits"]), bool(info_b["fits"])
+    if layout_l in {"auto", "replicate"} and fit_a and fit_b:
+        ca = DeviceCompactExternalCache.load(cache, dev_a, float_dtype=float_dtype, reserve_gib=reserve_gib, mode="on")
+        cb = DeviceCompactExternalCache.load(cache, dev_b, float_dtype=float_dtype, reserve_gib=reserve_gib, mode="on")
+        print("[compact-device-pair] layout=replicate", flush=True)
+        return ca, cb
+    if layout_l == "replicate":
+        if mode_l == "on":
+            raise RuntimeError("replicated compact device cache requested but both GPUs do not fit it")
+        return None, None
+
+    candidates: list[tuple[int, torch.device]] = []
+    if fit_a:
+        candidates.append((int(info_a["free"]), dev_a))
+    if fit_b:
+        candidates.append((int(info_b["free"]), dev_b))
+    if not candidates:
+        if mode_l == "on":
+            raise RuntimeError("compact device cache requested but neither GPU can fit one shared copy")
+        return None, None
+    _, source = max(candidates, key=lambda x: x[0])
+    cache_src = DeviceCompactExternalCache.load(
+        cache, source, float_dtype=float_dtype, reserve_gib=reserve_gib, mode="on"
+    )
+    if source == dev_a:
+        print("[compact-device-pair] layout=peer source=cuda:0 target=cuda:1", flush=True)
+        return cache_src, None
+    print("[compact-device-pair] layout=peer source=cuda:1 target=cuda:0", flush=True)
+    return None, cache_src
+
+
+def _paired_batches(
+    payload: Any,
+    *,
+    budget: int,
+    dev_a: torch.device,
+    dev_b: torch.device,
+    cache_a: DeviceCompactExternalCache | None,
+    cache_b: DeviceCompactExternalCache | None,
+    active_a: bool = True,
+    active_b: bool = True,
+) -> tuple[dict[str, torch.Tensor] | None, dict[str, torch.Tensor] | None]:
+    if isinstance(payload, dict):
+        return (
+            _to_device(payload, dev_a) if active_a else None,
+            _to_device(payload, dev_b) if active_b else None,
+        )
+    indices = np.asarray(payload, dtype=np.int64)
+    if cache_a is not None and cache_b is not None:
+        return (
+            cache_a.make_batch(indices, budget=budget) if active_a else None,
+            cache_b.make_batch(indices, budget=budget) if active_b else None,
+        )
+    if cache_a is not None:
+        source = cache_a.make_batch(indices, budget=budget)
+        return source if active_a else None, _to_device(source, dev_b) if active_b else None
+    if cache_b is not None:
+        source = cache_b.make_batch(indices, budget=budget)
+        return _to_device(source, dev_a) if active_a else None, source if active_b else None
+    raise RuntimeError("index loader requires at least one device-resident compact cache")
+
+
+@torch.inference_mode()
+def _validation_pair(
+    model_a: torch.nn.Module,
+    model_b: torch.nn.Module,
+    loader: Any,
+    cfg_a: dict[str, Any],
+    cfg_b: dict[str, Any],
+    dev_a: torch.device,
+    dev_b: torch.device,
+    *,
+    amp: bool,
+    log_every: int,
+    prefix: str,
+    budget: int,
+    cache_a: DeviceCompactExternalCache | None = None,
+    cache_b: DeviceCompactExternalCache | None = None,
+    active_a: bool = True,
+    active_b: bool = True,
+) -> tuple[dict[str, float], dict[str, float]]:
+    if active_a:
+        model_a.eval()
+    if active_b:
+        model_b.eval()
+    ma: dict[str, torch.Tensor] = {}
+    mb: dict[str, torch.Tensor] = {}
+    count_a = 0
+    count_b = 0
+    started = time.perf_counter()
+    total = len(loader)
+    print(
+        f"[{prefix}-start] batches={total} shared_loader=1 activeA={int(active_a)} activeB={int(active_b)} "
+        f"device_cache={int(cache_a is not None or cache_b is not None)}",
+        flush=True,
+    )
+    for step, payload in enumerate(loader, start=1):
+        ba, bb = _paired_batches(
+            payload,
+            budget=budget,
+            dev_a=dev_a,
+            dev_b=dev_b,
+            cache_a=cache_a,
+            cache_b=cache_b,
+            active_a=active_a,
+            active_b=active_b,
+        )
+        la = lb = None
+        if active_a:
+            assert ba is not None
+            with _amp_context(dev_a, amp):
+                la = compute_external_baseline_losses(model_a(ba), ba, cfg_a)
+            _accumulate(ma, la)
+            count_a += 1
+        if active_b:
+            assert bb is not None
+            with _amp_context(dev_b, amp):
+                lb = compute_external_baseline_losses(model_b(bb), bb, cfg_b)
+            _accumulate(mb, lb)
+            count_b += 1
+        if step % max(1, log_every) == 0 or step == total:
+            # These scalar reads are deliberately sparse.  They synchronize only
+            # at logging boundaries so the reported shared throughput is real.
+            lva = float(la["loss"].detach().cpu()) if la is not None else float("nan")
+            lvb = float(lb["loss"].detach().cpu()) if lb is not None else float("nan")
+            elapsed = max(time.perf_counter() - started, 1e-9)
+            print(
+                f"[{prefix}-progress] step={step}/{total} rate={step/elapsed:.2f} shared_batch/s "
+                f"loss_a={lva:.4f} loss_b={lvb:.4f} elapsed={elapsed:.1f}s",
+                flush=True,
+            )
+    return _finalize_meters(ma, count_a, "val_"), _finalize_meters(mb, count_b, "val_")
+
+
+def _copy_checkpoint(src: Path, dst: Path) -> None:
+    if src.resolve() == dst.resolve():
+        return
+    import shutil
+
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(src, dst)
+
+
+def _ensure_completed_checkpoint_aliases(output: str, resume_path: Path | None, *, epochs: int) -> None:
+    """Keep the historical latest/best filenames present for completed runs."""
+    latest = Path(output)
+    best = _best_checkpoint_path(output)
+    source = resume_path if resume_path is not None and resume_path.is_file() else (latest if latest.is_file() else best)
+    if source is None or not source.is_file():
+        return
+    start, _ = _peek_resume(source)
+    if start < epochs:
+        return
+    if not latest.is_file():
+        _copy_checkpoint(source, latest)
+    if not best.is_file():
