+                anchor_idx = int(np.flatnonzero(finite_anchor)[np.argmin(anchor_cost[finite_anchor])])
+                rival_idx = np.flatnonzero(valid & (np.arange(valid.size) != anchor_idx) & np.isfinite(corrected_cost))
+                if rival_idx.size:
