+
+def _icer(c):
+    return c["runtime"]["decisive_frontier_value"]["incumbent_contrastive_extremal_recovery"]
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description="Check frozen V64.3.23 EAF-ICER-RCR contract.")
