+    "V64.3.12-CC-AOCC-CET-BDMU-DARM-DBR",
+    "V64.3.13-EAF-DMVR-DARM-DBR",
+}
+V64_3_REQUIRED_TRAINABLE = {
+    "critical_proposal_adapter",
+    "residual_action_head",
+    "residual_action_var_head",
+    "residual_set_atom_head",
+    "residual_set_action_head",
