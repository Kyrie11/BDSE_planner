+                [0.0, 0.0, 0.4],
+            ],
+            dtype=np.float32,
+        ),
+        pair_indices=np.asarray([[0, 1], [0, 2], [1, 2]], dtype=np.int64),
+        pair_weights=np.ones((3,), dtype=np.float32),
+        atom_budget_costs=np.ones((3,), dtype=np.float32),
