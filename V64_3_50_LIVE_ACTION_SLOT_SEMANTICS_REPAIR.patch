+        __import__('pathlib').Path('bdse/configs/v64_3_4_cc_aocc_mrbcca_cl.yaml'),
+        'eval',
+        'v64.3.4',
+    )
+    assert train['pass'], train['failures']
+    assert evaluate['pass'], evaluate['failures']
