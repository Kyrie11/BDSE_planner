+    main = root / "bdse/configs/v39_bdse_dacc_fast_cl.yaml"
+    fallback = root / "bdse/configs/v39_bdse_dacc_fallback_fast_cl.yaml"
+    control = root / "bdse/configs/v39_bdse_mars_control_fast_cl.yaml"
