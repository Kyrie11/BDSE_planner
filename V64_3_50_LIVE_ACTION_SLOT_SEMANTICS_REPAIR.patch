+def _sig(d: dict[str, Any]) -> tuple[Any, Any, Any, Any, float]:
+    return (
+        d.get("selected_count"),
+        d.get("selected_positive_count"),
+        d.get("no_positive_opportunity_false_intervention_count"),
+        d.get("catastrophic_count"),
