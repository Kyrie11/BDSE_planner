+
+    print(f"\nV54 protocol-integrity gate [{'PASS' if protocol_pass else 'FAIL'}]")
+    print(f"V54 minimum-completeness gate [{'PASS' if minimum_pass else 'FAIL'}]")
+    print(f"V54 competitive gate [{'PASS' if competitive_pass else 'FAIL'}]")
+    print(json.dumps(report["metrics"], indent=2, sort_keys=True))
