+def test_v64_3_6_configs_and_trainable_contracts() -> None:
+    for tag in ('local', 'bcha', 'lbpr', 'bcha_lbpr'):
+        train = Path(f'bdse/configs/v64_3_6_cc_aocc_ccbr_{tag}_lea_daepc_screen_2gpu.yaml')
