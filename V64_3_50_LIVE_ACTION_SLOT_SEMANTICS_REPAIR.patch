+EPS = 1.0e-12
+MIN_VALUE_CAL_PROPOSALS = 64
+NOOP_REDUCTION_MIN = 0.20
+CAPTURE_TOL = 0.03
+CATASTROPHE_REDUCTION_MIN = 0.25
