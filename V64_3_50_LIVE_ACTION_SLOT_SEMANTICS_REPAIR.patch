+def restrict_pairs_to_viability_frontier(
+    pairs: np.ndarray,
+    pair_weights: np.ndarray | None,
+    valid_mask: np.ndarray,
+    safety_flags: np.ndarray,
+    predicted_base_cost: np.ndarray,
+    *,
+    hard_risk: np.ndarray | None = None,
+    frontier_size: int = 8,
+    single_safe_rivals: int = 8,
