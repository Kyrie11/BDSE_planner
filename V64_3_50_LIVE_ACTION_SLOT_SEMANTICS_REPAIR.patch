+        z = report.get("last_val_" + stem)
+        report["delta_val_" + stem] = (z - a) if a is not None and z is not None else None
+
+    required = [
+        "critical_adapter_parameter_delta_rms_max",
+        "critical_proposal_residual_rms_max",
