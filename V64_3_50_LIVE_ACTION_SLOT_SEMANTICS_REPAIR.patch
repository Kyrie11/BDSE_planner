+        tcfg = cfg.get("teacher", {}) if isinstance(cfg, dict) else {}
+        w = float(tcfg.get("demo_weight", 1.0)) / max(float(tcfg.get("demo_scale", 120.0)), 1.0e-6)
+        return _finite(np.maximum(features[:, 0] * w, 0.0))
