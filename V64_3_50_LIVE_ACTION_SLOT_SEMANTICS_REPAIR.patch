+        "checks": checks,
+        "pass": all(checks.values()),
+        "utility_projection_fixture": sorted(projected_ids),
+        "expected_fixture": sorted(expected),
+        "family_slot_fixture": sorted(family_projected_ids),
+        "family_slot_expected": sorted(family_expected),
