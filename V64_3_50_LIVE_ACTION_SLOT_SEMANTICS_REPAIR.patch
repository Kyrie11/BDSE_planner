+         "teacher_margin": 0.35, "icer_admissible": 1.0, "icer_selected_action": 2,
+         "icer_support_logit": 1.0, "icer_dominance_logit": 1.0,
+         "icer_scalar_dominance_logit": 1.0, "icer_profile_dominance_logit": 1.0},
