+def _head_schema(mode: str) -> tuple[list[str], list[str]]:
+    dummy = np.zeros((1, len(_DACER_FEATURE_NAMES)), dtype=np.float64)
+    _, names, base = _icer_quadratic_interaction_features(dummy, list(_DACER_FEATURE_NAMES), mode)
+    return names, base
