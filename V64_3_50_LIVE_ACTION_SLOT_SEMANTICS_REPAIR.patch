+    out: dict[tuple[str, int], dict[str, Any]] = {}
+    for row in rows:
+        key = _key(row)
+        if not key[0] or key in out:
+            raise ValueError(f"{label} has empty/duplicate key {key}")
+        out[key] = row
+    return out
