+
+EPS = 1.0e-12
+LBFGS_MAX_ITER = 250
+LBFGS_HISTORY = 50
+CONTEXT_NAMES = [f"incumbent::{n}" for n in BASE_FEATURE_NAMES] + ["incumbent::support_logit"]
+CONTEXT_GAIN_MIN_FRACTION = 0.20
+CAPTURE_TOL = 0.03
