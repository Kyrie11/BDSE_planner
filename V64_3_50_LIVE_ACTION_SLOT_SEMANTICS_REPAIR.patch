+def _register_closed_loop_profile_flush() -> None:
+    global _CLOSED_LOOP_PROFILE_REGISTERED
+    if _CLOSED_LOOP_PROFILE_REGISTERED:
+        return
+    _CLOSED_LOOP_PROFILE_REGISTERED = True
+    atexit.register(_flush_closed_loop_profile)
