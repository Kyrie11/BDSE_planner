+            "J0": (outputs["J0"], torch.float32),
+            "g_np": (
+                outputs.get("g") if pair_head_needs_local and "g" in outputs else None,
+                torch.float32,
+            ),
+            "delta": (pair_delta_t, torch.float32),
+            "pair_var": (
