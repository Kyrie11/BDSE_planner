+        {'decisive_frontier_value_residual_rms':.2,'decisive_frontier_value_residual_abs_mean':.1,
+         'decisive_frontier_value_attribution_scale_rms':.12,'decisive_frontier_value_attribution_scale_mean':.1},1.0,_cfg(False))
