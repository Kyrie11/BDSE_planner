+        lf = np.asarray(local[j], dtype=np.float64)
+        pf = np.asarray(plan[0, j], dtype=np.float64)
+        if not (np.all(np.isfinite(lf)) and np.all(np.isfinite(pf)) and np.isfinite(target)):
+            continue
