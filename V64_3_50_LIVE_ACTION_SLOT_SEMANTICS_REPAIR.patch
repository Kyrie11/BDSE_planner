+def make_default_route_centerline(horizon_m: float = 160.0, step_m: float = 2.0) -> np.ndarray:
+    x = np.arange(0.0, horizon_m + step_m, step_m, dtype=np.float32)
+    return np.stack([x, np.zeros_like(x)], axis=1)
