+            for k, v in oi.items():
+                if k.startswith(prefix):
+                    assert ni[k] == v
+        assert ni["dominance_policy"] == oi["dominance_policy"]
+        assert ni["all_flagged_policy"] == "preserve_legacy_for_structural_guard"
