+            "J0": J0_deployment,
+            "J0_deployment": J0_deployment,
+            "J0_model": J0_model,
+            "g": g,
+            "g_var": g_var_np,
+            "query_features": self._query_contract_view(
+                dense_batch["evidence_query_features"][0]
