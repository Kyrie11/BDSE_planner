+        elif direction == ">=" and value + 1e-12 < threshold:
+            failures.append(f"{key}={value:.6f} < {threshold:.6f}")
+        elif direction == "<=" and value - 1e-12 > threshold:
+            failures.append(f"{key}={value:.6f} > {threshold:.6f}")
+
