+            bytok[tok] = Path(p)
+    miss = want - set(bytok)
+    if miss:
+        raise SystemExit(f"STOP V46 DATA: current-state cache missing {len(miss)} frozen tokens")
+
+    out = Path(a.output_sidecar)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    replay_max = 0.0
+    with out.open("w") as f:
