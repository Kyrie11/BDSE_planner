+fr={x.strip() for x in open(sys.argv[1]) if x.strip()}; ex={x.strip() for x in open(sys.argv[2]) if x.strip()}; tr={x.strip() for x in open(sys.argv[3]) if x.strip()}
+if len(fr)!=1000 or len(ex)!=8700 or len(tr)!=3000 or fr&ex or fr&tr: raise SystemExit(f'STOP DATA: V31 fresh isolation failure fresh={len(fr)} ex={len(ex)} train={len(tr)} overlaps={len(fr&ex)}/{len(fr&tr)}')
