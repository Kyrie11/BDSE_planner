+        if len(vals) not in {2, 3}:
+            raise RuntimeError(f"V64.3.50.3 PIOR unexpected mapping entry {typ}={vals}")
+        repaired = [float(vals[0]), 0.0] + ([float(vals[2])] if len(vals) == 3 else [])
