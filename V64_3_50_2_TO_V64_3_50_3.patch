+    if not isinstance(scenario_map, dict) or not scenario_map:
+        raise RuntimeError(f"V64.3.50.3 PIOR malformed nuPlan scenario mapping: {mapping_path}")
+    overrides: list[str] = []
+    for typ in sorted(scenario_map):
