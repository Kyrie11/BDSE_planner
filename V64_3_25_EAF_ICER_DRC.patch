+export EAF_TRAIN_LOG="${EAF_TRAIN_LOG:-$EAF_V64_3_13_ROOT/train/bdse_v64_saqa_bcc.train_log.jsonl}"
+export OUT_ROOT="${OUT_ROOT:-outputs_v64_3_25_eaf_icer_drc_screen_2gpu_v1}"
