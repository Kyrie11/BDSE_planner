+    cfg.setdefault("provenance",{})["algorithm_version"] = "V64.3.33-EAF-ICER-SPCR"
+    exp = cfg.setdefault("experiment",{}); exp["name"]="v64_3_33_eaf_icer_spcr"; exp["algorithm"]="V64.3.33 SPCR: incumbent-augmented selection-consistent pair-gap ordering with selected-policy conformal certificate"
