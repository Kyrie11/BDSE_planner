+        },
+        'tournament': {'utility_refinement': {'enabled': False}},
+    }
+
+
+def _matrix() -> np.ndarray:
+    M=np.zeros((3,3),dtype=np.float32)
+    M[1,0]=0.30; M[0,1]=-0.30
+    M[2,0]=0.50; M[0,2]=-0.50
+    return M
