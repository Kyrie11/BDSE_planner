+python - "$TRAIN_RAW_ROWS" "$TRAIN_EDGES" <<'PY'
+import json,math,sys
+rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
+prop=[r for r in rows if r.get('raw_frontier_anchor_action')!=r.get('raw_frontier_proposed_action') and r.get('decisive_frontier_value_teacher_proposed_vs_anchor_margin') is not None]
+if len(prop)<256: raise SystemExit(f'STOP: only {len(prop)} TRAIN top proposal edges')
+edge_rows=[json.loads(x) for x in open(sys.argv[2]) if x.strip()]
+if len(edge_rows)<2048: raise SystemExit(f'STOP CAPACITY: only {len(edge_rows)} all-frontier TRAIN edges')
+feature_keys=[k for k in edge_rows[0] if k.startswith('daler_feature_')]
+if len(feature_keys)<20: raise SystemExit(f'STOP ENGINEERING: DALER feature schema missing, found {len(feature_keys)}')
+for key in feature_keys:
+    cov=sum(math.isfinite(float(r.get(key,float('nan')))) for r in edge_rows)/len(edge_rows)
+    if cov<.99: raise SystemExit(f'STOP ENGINEERING: {key} coverage={cov:.3f}')
+exec_edges=sum(float(r.get('daler_executable',0))>=.5 for r in edge_rows)
