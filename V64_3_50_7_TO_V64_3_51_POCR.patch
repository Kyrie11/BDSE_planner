+def test_v51_tournament_computes_runtime_treatment_control_contrast_without_reranking():
+    raw_names=list(_ICER_REGRET_RISK_EVIDENCE_BASE_NAMES)
+    feature_names=[f"delta::{n}" for n in raw_names]+["delta::support_logit"]
