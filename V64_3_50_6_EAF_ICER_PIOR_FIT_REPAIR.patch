+    return {
+        "use_extremal_multiplicity": False,
+        "feature_mean": [0.0, 0.0, 0.0, 0.0],
+        "feature_std": [1.0, 1.0, 1.0, 1.0],
+        "weights": [1.0, 0.0, 0.0, 0.0],
+        "fit_positive_score_mean": 0.0,
