+def _state(r: dict[str, Any], arm: str) -> np.ndarray:
+    return outcome_state_from_profile(
+        float(r["quality_value"]), float(r["plan_control_value"]), float(r["ego_ref_value"]),
+        dict(r["operator_trajectory_profile"]), state_family=arm,
+    )
