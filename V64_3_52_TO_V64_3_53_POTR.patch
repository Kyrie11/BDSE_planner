+def _names(arm: str) -> list[str]:
+    if arm == "endpoint": return list(POTR_ENDPOINT_STATE_NAMES)
+    if arm == "temporal": return list(POTR_TEMPORAL_STATE_NAMES)
+    raise ValueError(arm)
